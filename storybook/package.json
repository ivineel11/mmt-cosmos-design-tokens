{
  "name": "cosmos-storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook for the MakeMyTrip Cosmos foundations, tokens and components.",
  "type": "module",
  "scripts": {
    "tokens": "node ../docs-site/scripts/generate-tokens.mjs",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "connect:icons": "node scripts/generate-icon-code-connect.mjs",
    "connect:publish": "figma connect publish"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "libphonenumber-js": "^1.13.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
